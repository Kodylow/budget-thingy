# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

# No need to store the pnpm store twice.
.local

# Workspace-only material is not part of the deployed application.
.git
.agents
.cache
.config
attached_assets
screenshots
e2e
artifacts/mockup-sandbox
**/evidence
**/playwright-report
**/test-results
.env
.env.*
*.env
*.xlsx
*.bundle
*.zip
*.tar
*.tar.gz
*.tgz
fix-*.js
rewrite-spend.js
update-spend.js
disable-test.js
remove-padding.js
